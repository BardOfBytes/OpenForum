# ========================
# Node / Next.js
# ========================
node_modules/
.pnpm-store/
.next/
out/
dist/
.turbo/
*.tsbuildinfo

# ========================
# Rust
# ========================
target/
**/*.rs.bk
Cargo.lock
# Note: Cargo.lock is ignored because apps/api is a binary,
# but for libraries you'd typically commit it.
# We re-include it below for the api workspace.
!apps/api/Cargo.lock

# ========================
# Environment variables
# ========================
# Ignore every .env variant (including backups such as .env.backup-20260101,
# .env.prod, .env.save) and re-admit only the tracked templates. The previous
# rules listed exact names, so an ad-hoc backup of a real .env was left
# untracked-but-visible and one `git add -A` away from being committed.
.env*
!.env.example
!.env*.example
Render.env
*.env.backup*
*creds*.txt
*credentials*.json
*service-account*.json

# ========================
# OS & Editor
# ========================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/settings.json
.idea/

# ========================
# Logs
# ========================
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ========================
# Vercel
